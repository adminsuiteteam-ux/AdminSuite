# ==============================================================================
# ADMINSUITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.credentials and supply your private credentials.
# NEVER commit your actual .env or .env.credentials file to Git.
# ==============================================================================

# ── 1. DJANGO CORE & BACKEND ───────────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://adminsuite.onrender.com,https://adminsuite-web.onrender.com,http://localhost:5173,http://localhost:8081

# Superuser Initial Setup (Endpoint: /setup-admin/?token=...)
SETUP_SECRET_TOKEN=your-setup-secret-token
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-password

# ── 2. DATABASE CONFIGURATION (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── 3. SUPABASE (Auth & Realtime) ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── 4. STRIPE BILLING & SUBSCRIPTIONS ──────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 5. CLOUDINARY (Media Storage) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── 6. EMAIL PROVIDERS ─────────────────────────────────────────────────────────
# ZeptoMail (Primary)
ZEPTOMAIL_SEND_MAIL_TOKEN=Zoho-enczapikey ...

# Brevo / Sendinblue (Secondary)
BREVO_API_KEY=xkeysib-...

# Gmail SMTP (Fallback)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
DEFAULT_FROM_EMAIL=AdminSuite <noreply@yourdomain.com>

# ── 7. GOOGLE OAUTH 2.0 ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-client-id.apps.googleusercontent.com

# ── 8. DAILY.CO VIDEO CALLING ─────────────────────────────────────────────────
DAILY_API_KEY=your-daily-co-api-key
DAILY_DOMAIN=your-daily-domain

# ── 9. AI / GOOGLE GEMINI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
AI_ENABLED=True

# ── 10. ERROR MONITORING (Sentry) ─────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project-id
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── 11. APPLICATION URLS ──────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://adminsuite-api.onrender.com
RENDER_EXTERNAL_HOSTNAME=adminsuite-api.onrender.com
LANDING_URL=https://adminsuite.onrender.com
WEB_APP_URL=https://adminsuite-web.onrender.com
